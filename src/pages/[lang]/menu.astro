      </div>
    </div>
  </section>

  <!-- Warm Lunch Section (Placeholder) -->
  <section id="warm-lunch" class="pt-12 pb-32 bg-white relative overflow-hidden scroll-mt-40 border-t border-primary/10">
    <div class="orb w-[600px] h-[600px] bg-orange-500/5 bottom-[-200px] right-[-100px]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16 space-y-6">
        <p class="text-primary font-bold uppercase tracking-[0.4em] text-xs">Hearty & Delicious</p>
