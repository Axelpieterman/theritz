---

<Layout title={`${t('nav.menu')} - The Ritz`} lang={lang} showMenuTabs={true}>
  <!-- Hero Section -->
  <section class="relative h-[60vh] min-h-[400px] overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="/vlad-menu.jpg" alt="The Ritz Menu" class="w-full h-full object-cover scale-110 animate-[ken-burns_20s_ease-in-out_infinite_alternate]" />
      <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-background"></div>
    </div>
    <div class="relative z-10 h-full flex items-center justify-center">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-primary font-bold uppercase tracking-[0.4em] text-xs mb-6">Serving Excellence</p>
        <h1 class="text-5xl md:text-7xl font-black text-white uppercase tracking-tighter leading-none mb-6">
          Our Menu
        </h1>
        <div class="h-[2px] w-24 bg-primary mx-auto mb-8"></div>
        <p class="text-xl md:text-2xl text-white/80 max-w-2xl mx-auto font-medium">
          From breakfast to cocktails, discover our full selection
        </p>
      </div>
    </div>
  </section>

  <style>
    @keyframes ken-burns {
      0% { transform: scale(1); }
      100% { transform: scale(1.1); }
    }
  </style>


  <!-- Featured Drinks with Photos -->
  <section class="py-20 bg-mesh relative overflow-hidden">
    <div class="orb w-[600px] h-[600px] bg-primary/8 top-[-300px] right-[-100px]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16 space-y-6">
        <p class="text-primary font-bold uppercase tracking-[0.4em] text-xs">Signature Selection</p>
        <h2 class="text-4xl md:text-6xl font-black text-foreground uppercase tracking-tighter leading-none text-balance">
          Featured Drinks
        </h2>
        <div class="h-[2px] w-24 bg-primary mx-auto"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="group bg-white rounded-[2rem] overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
          <div class="aspect-square overflow-hidden">
            <img src="/gin-tonic-pink.jpg" alt="Pink Gin Tonic" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">Pink Gin Tonic</h3>
            <p class="text-sm text-muted-foreground mt-2">Elegant & Refreshing</p>
          </div>
        </div>
        
        <div class="group bg-white rounded-[2rem] overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
          <div class="aspect-square overflow-hidden">
            <img src="/choco-loco-cocktail.jpg" alt="Choco Loco" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">Choco Loco</h3>
            <p class="text-sm text-muted-foreground mt-2">Rich & Indulgent</p>
          </div>
        </div>
        
        <div class="group bg-white rounded-[2rem] overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
          <div class="aspect-square overflow-hidden">
            <img src="/sex-on-the-beach.jpg" alt="Sex on the Beach" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">Sex on the Beach</h3>
            <p class="text-sm text-muted-foreground mt-2">Tropical & Fruity</p>
          </div>
        </div>
        
        <div class="group bg-white rounded-[2rem] overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
          <div class="aspect-square overflow-hidden">
            <img src="/schnapz.jpg" alt="Schnapz" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">Schnapz</h3>
            <p class="text-sm text-muted-foreground mt-2">Bold & Crisp</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cocktails Section -->
  <section id="cocktails" class="pt-12 pb-32 bg-white relative overflow-hidden scroll-mt-40 border-t border-primary/10">
    <div class="orb w-[500px] h-[500px] bg-primary/5 top-[20%] right-[10%]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-20 space-y-4">
        <p class="text-primary font-bold uppercase tracking-[0.4em] text-[10px]">Serving Bad Ideas in Fancy Glasses</p>
        <h2 class="text-5xl md:text-7xl font-black text-foreground uppercase tracking-tighter leading-[0.9]">
          Cocktails
        </h2>
        <div class="h-[3px] w-20 bg-gradient-to-r from-transparent via-primary to-transparent mx-auto"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {menuData.cocktails.map((item) => (
          <div class="group relative bg-white p-8 rounded-[2rem] shadow-[0_4px_20px_rgba(0,0,0,0.08)] hover:shadow-[0_8px_30px_rgba(197,160,89,0.15)] transition-all duration-500 border border-black/5 hover:border-primary/20 hover:-translate-y-1">
            <div class="absolute inset-0 bg-gradient-to-br from-primary/[0.02] to-transparent rounded-[2rem] opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative">
              <div class="flex justify-between items-start mb-4 gap-4">
                <h3 class="text-xl font-black text-foreground uppercase tracking-tight leading-tight group-hover:text-primary transition-colors duration-300">{item.name}</h3>
                <span class="text-2xl font-black text-primary shrink-0">€{item.price.toFixed(2)}</span>
              </div>
              <p class="text-muted-foreground leading-relaxed text-[15px]">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mocktails Section -->
  <section id="mocktails" class="pt-12 pb-32 bg-mesh relative overflow-hidden scroll-mt-40 border-t border-primary/10">
    <div class="orb w-[600px] h-[600px] bg-accent/5 bottom-[-200px] left-[-100px]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-20 space-y-4">
        <p class="text-primary font-bold uppercase tracking-[0.4em] text-[10px]">Serving Smart Ideas in Fancy Glasses</p>
        <h2 class="text-5xl md:text-7xl font-black text-foreground uppercase tracking-tighter leading-[0.9]">
          Mocktails
        </h2>
        <div class="h-[3px] w-20 bg-gradient-to-r from-transparent via-primary to-transparent mx-auto"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {menuData.mocktails.map((item) => (
          <div class="group relative bg-white p-8 rounded-[2rem] shadow-[0_4px_20px_rgba(0,0,0,0.08)] hover:shadow-[0_8px_30px_rgba(197,160,89,0.15)] transition-all duration-500 border border-black/5 hover:border-primary/20 hover:-translate-y-1">
            <div class="absolute inset-0 bg-gradient-to-br from-primary/[0.02] to-transparent rounded-[2rem] opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative">
              <div class="flex justify-between items-start mb-4 gap-4">
                <h3 class="text-xl font-black text-foreground uppercase tracking-tight leading-tight group-hover:text-primary transition-colors duration-300">{item.name}</h3>
                <span class="text-2xl font-black text-primary shrink-0">€{item.price.toFixed(2)}</span>
              </div>
              <p class="text-muted-foreground leading-relaxed text-[15px]">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Breakfast Section -->
  <section id="breakfast" class="pt-12 pb-32 bg-white relative overflow-hidden scroll-mt-40 border-t border-primary/10">
    <div class="orb w-[400px] h-[400px] bg-amber-500/5 top-[10%] left-[5%]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-20 space-y-4">
        <p class="text-primary font-bold uppercase tracking-[0.4em] text-[10px]">Mornings Made Delicious</p>
        <h2 class="text-5xl md:text-7xl font-black text-foreground uppercase tracking-tighter leading-[0.9]">
          Breakfast
        </h2>
        <div class="h-[3px] w-20 bg-gradient-to-r from-transparent via-primary to-transparent mx-auto"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {menuData.breakfast.map((item) => (
          <div class="group bg-background p-8 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-primary/10 hover:border-primary/30">
            <div class="flex justify-between items-start mb-3">
              <div>
                {item.number && <span class="text-sm font-bold text-primary mb-2 block">{item.number}.</span>}
                <h3 class="text-xl font-bold text-foreground uppercase tracking-tight group-hover:text-primary transition-colors">{item.name}</h3>
              </div>
              <span class="text-2xl font-black text-primary">€{item.price.toFixed(2)}</span>
            </div>
            <p class="text-muted-foreground leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Lunch Section -->
  <section id="lunch" class="pt-12 pb-32 bg-mesh relative overflow-hidden scroll-mt-40 border-t border-primary/10">
    <div class="orb w-[500px] h-[500px] bg-green-500/5 top-[30%] right-[10%]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16 space-y-6">
        <p class="text-primary font-bold uppercase tracking-[0.4em] text-xs">The Perfect Midday Bite</p>
        <h2 class="text-4xl md:text-6xl font-black text-foreground uppercase tracking-tighter leading-none">
          Lunch
        </h2>
        <div class="h-[2px] w-24 bg-primary mx-auto"></div>
      </div>

      <!-- Baguettes -->
      <div class="mb-20">
        <h3 class="text-3xl font-black text-foreground uppercase tracking-tight mb-10 flex items-center gap-3">
          <span class="text-4xl">🥖</span>
          Baguettes
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {menuData.baguettes.map((item) => (
            <div class="group bg-white p-8 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-primary/10 hover:border-primary/30">
              <div class="flex justify-between items-start mb-3">
                <div>
                  {item.number && <span class="text-sm font-bold text-primary mb-2 block">{item.number}.</span>}
                  <h4 class="text-xl font-bold text-foreground uppercase tracking-tight group-hover:text-primary transition-colors">{item.name}</h4>
                </div>
                <span class="text-2xl font-black text-primary">€{item.price.toFixed(2)}</span>
              </div>
              <p class="text-muted-foreground leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Salads -->
      <div>
        <h3 class="text-3xl font-black text-foreground uppercase tracking-tight mb-10 flex items-center gap-3">
          <span class="text-4xl">🥗</span>
          Salads
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {menuData.salads.map((item) => (
            <div class="group bg-white p-8 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-primary/10 hover:border-primary/30">
              <div class="flex justify-between items-start mb-3">
                <div>
                  {item.number && <span class="text-sm font-bold text-primary mb-2 block">{item.number}.</span>}
                  <h4 class="text-xl font-bold text-foreground uppercase tracking-tight group-hover:text-primary transition-colors">{item.name}</h4>
                </div>
                <span class="text-2xl font-black text-primary">€{item.price.toFixed(2)}</span>
              </div>
              <p class="text-muted-foreground leading-relaxed">{item.description}</p>
            </div>
          ))}
