---
import Layout from '../../layouts/Layout.astro';
import { languages, type Language } from '../../i18n/languages';
import { useTranslations } from '../../i18n/ui';
import { MapPin, Phone, Clock, Instagram, Facebook, Mail } from 'lucide-react';
import { Button } from '../../components/ui/button';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);
---

<Layout title={`${t('nav.contact')} - The Ritz`} lang={lang}>
  <!-- Hero Section -->
  <section class="relative py-20 pt-32 bg-gradient-to-br from-accent/20 to-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-bold mb-6 text-foreground">
        {t('nav.contact')}
      </h1>
      <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
        We'd love to hear from you!
      </p>
    </div>
  </section>

  <!-- Contact Information -->
  <section class="py-20 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Left Side - Contact Details -->
        <div class="space-y-8">
          <div>
            <h2 class="text-4xl font-bold mb-8 text-foreground">Get in Touch</h2>
            <p class="text-lg text-muted-foreground mb-8">
              Whether you want to make a reservation, inquire about events, or just say hello, 
              we're here to help. Reach out to us through any of the methods below.
            </p>
          </div>

          <!-- Contact Cards -->
          <div class="space-y-6">
            <!-- Location -->
            <div class="bg-card p-6 rounded-lg shadow-md border">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                  <MapPin className="w-6 h-6 text-primary" />
                </div>
                <div>
                  <h3 class="text-xl font-semibold mb-2 text-foreground">Location</h3>
                  <p class="text-muted-foreground">
                    {t('contact.address')}
                  </p>
                  <a 
                    href="https://maps.google.com/?q=Carrer+del+Carme+43+Lloret+de+Mar" 
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-accent hover:underline mt-2 inline-block"
                  >
                    Open in Maps →
                  </a>
                </div>
              </div>
            </div>

            <!-- Phone -->
            <div class="bg-card p-6 rounded-lg shadow-md border">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                  <Phone className="w-6 h-6 text-primary" />
                </div>
                <div>
                  <h3 class="text-xl font-semibold mb-2 text-foreground">{t('contact.phone')}</h3>
                  <a 
                    href="tel:+31618758383"
                    class="text-muted-foreground hover:text-accent transition-colors"
                  >
                    +31 6 18758383
                  </a>
                  <div class="mt-3">
                    <a 
                      href="https://wa.me/31618758383" 
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <Button variant="default" size="sm">
                        Message on WhatsApp
                      </Button>
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <!-- Hours -->
            <div class="bg-card p-6 rounded-lg shadow-md border">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                  <Clock className="w-6 h-6 text-primary" />
                </div>
                <div>
                  <h3 class="text-xl font-semibold mb-2 text-foreground">Opening Hours</h3>
                  <p class="text-muted-foreground">
                    {t('contact.hours')}
                  </p>
                  <p class="text-sm text-muted-foreground mt-2">
                    Contact us for specific hours and seasonal changes
                  </p>
                </div>
              </div>
            </div>

            <!-- Social Media -->
            <div class="bg-card p-6 rounded-lg shadow-md border">
              <h3 class="text-xl font-semibold mb-4 text-foreground">Follow Us</h3>
              <div class="flex gap-4">
                <a 
                  href="https://instagram.com" 
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center hover:bg-primary/20 transition-colors"
                >
                  <Instagram className="w-6 h-6 text-primary" />
                </a>
                <a 
                  href="https://facebook.com" 
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center hover:bg-primary/20 transition-colors"
                >
                  <Facebook className="w-6 h-6 text-primary" />
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Side - Map Placeholder -->
        <div class="space-y-6">
          <div class="bg-card rounded-lg shadow-lg overflow-hidden border">
            <div class="aspect-square">
              <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2971.8472874396487!2d2.8450!3d41.7020!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12bae72e0d6f3f3f%3A0x0!2sCarrer%20del%20Carme%2C%2043%2C%2017310%20Lloret%20de%20Mar%2C%20Girona%2C%20Spain!5e0!3m2!1sen!2s!4v1234567890"
                width="100%" 
                height="100%" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade"
                title="The Ritz Location"
              ></iframe>
            </div>
          </div>
          
          <div class="text-center">
            <a 
              href="https://www.google.com/maps/dir//Carrer+del+Carme,+43,+17310+Lloret+de+Mar,+Girona,+Spain" 
              target="_blank"
              rel="noopener noreferrer"
            >
              <Button variant="default" size="lg" className="w-full">
                Get Directions
              </Button>
            </a>
          </div>

          <div class="bg-primary text-primary-foreground rounded-lg p-8">
            <h3 class="text-2xl font-bold mb-4">Quick Reservation</h3>
            <p class="mb-6 text-primary-foreground/90">
              Book your table instantly via WhatsApp. We'll get back to you within minutes!
            </p>
            <a 
              href="https://wa.me/31618758383?text=Hi!%20I%27d%20like%20to%20make%20a%20reservation%20at%20The%20Ritz." 
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block"
            >
              <Button 
                variant="outline" 
                size="lg"
                className="bg-transparent border-2 border-primary-foreground text-primary-foreground hover:bg-primary-foreground hover:text-primary w-full"
              >
                Reserve Now on WhatsApp
              </Button>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 bg-card">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold mb-6 text-foreground">Frequently Asked Questions</h2>
        <div class="h-1 w-24 bg-accent mx-auto"></div>
      </div>

      <div class="space-y-6">
        <div class="bg-background p-6 rounded-lg shadow-md">
          <h3 class="text-xl font-semibold mb-3 text-foreground">Do I need a reservation?</h3>
          <p class="text-muted-foreground">
            While walk-ins are welcome, we recommend making a reservation via WhatsApp to ensure you get a table, 
            especially during peak hours and special events.
          </p>
        </div>

        <div class="bg-background p-6 rounded-lg shadow-md">
          <h3 class="text-xl font-semibold mb-3 text-foreground">What payment methods do you accept?</h3>
          <p class="text-muted-foreground">
            We accept cash, all major credit cards, and digital payment methods. Contact us for specific details.
          </p>
        </div>

        <div class="bg-background p-6 rounded-lg shadow-md">
          <h3 class="text-xl font-semibold mb-3 text-foreground">Can you host private events?</h3>
          <p class="text-muted-foreground">
            Yes! The Ritz is perfect for private parties, celebrations, and corporate events. 
            Contact us via WhatsApp to discuss your requirements.
          </p>
        </div>

        <div class="bg-background p-6 rounded-lg shadow-md">
          <h3 class="text-xl font-semibold mb-3 text-foreground">Do you offer vegetarian/vegan options?</h3>
          <p class="text-muted-foreground">
            Absolutely! We have a variety of vegetarian and vegan options available. 
            Check our menu or ask our staff for recommendations.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

