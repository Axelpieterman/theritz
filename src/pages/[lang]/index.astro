---
import Layout from '../../layouts/Layout.astro';
import { Button } from '../../components/ui/button';
import { useTranslations } from '../../i18n/ui';
import { languages, type Language } from '../../i18n/languages';
import { Martini, UtensilsCrossed, Waves, Music, MapPin, Phone } from 'lucide-react';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);
---

<Layout title={`The Ritz - Lloret de Mar | ${t('hero.title')}`} lang={lang}>
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img src="/bar-photo-1.jpg" alt="The Ritz Bar" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/40 to-black/60"></div>
    </div>
    
    <!-- Hero Content with Translucent Box -->
    <div class="relative z-10 text-center px-4 py-20 max-w-5xl mx-auto">
      <div class="bg-black/40 backdrop-blur-md rounded-3xl p-8 md:p-12 lg:p-16 shadow-2xl border border-white/20">
        <!-- Logo with animation -->
        <div class="mb-8">
          <img 
            src="/ritzlogo.png" 
            alt="The Ritz Logo" 
            class="h-28 md:h-40 w-auto mx-auto mb-6 animate-float drop-shadow-2xl brightness-0 invert" 
          />
        </div>
        
        <!-- Main Heading -->
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold text-white mb-6 drop-shadow-2xl leading-tight uppercase">
          {t('hero.title')}
        </h1>
        
        <!-- Subtitle -->
        <div class="mb-8">
          <p class="text-2xl md:text-3xl lg:text-4xl text-accent font-bold mb-3 drop-shadow-lg uppercase">
            {t('hero.subtitle')}
          </p>
          <div class="h-1 w-32 bg-accent mx-auto mb-6"></div>
        </div>
        
        <!-- Description -->
        <p class="text-lg md:text-xl lg:text-2xl text-white mb-10 max-w-3xl mx-auto leading-relaxed">
          {t('hero.description')}
        </p>
        
        <!-- CTA Buttons - Enhanced -->
        <div class="flex flex-col sm:flex-row gap-5 justify-center items-center mb-8">
          <a href={`/${lang}/menu`} class="w-full sm:w-auto">
            <button class="w-full sm:w-auto px-10 py-5 text-lg font-bold uppercase tracking-wide bg-white text-primary rounded-xl hover:bg-accent hover:text-white transition-all duration-300 shadow-xl hover:shadow-2xl hover:scale-105 transform">
              {t('hero.cta.menu')}
            </button>
          </a>
          <a href="https://wa.me/31618758383" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto">
            <button class="w-full sm:w-auto px-10 py-5 text-lg font-bold uppercase tracking-wide bg-accent text-white rounded-xl hover:bg-primary transition-all duration-300 shadow-xl hover:shadow-2xl hover:scale-105 transform flex items-center justify-center gap-3">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              {t('hero.cta.reserve')}
            </button>
          </a>
        </div>
        
        <!-- Location Badge -->
        <div class="inline-block bg-white/20 backdrop-blur-sm px-6 py-3 rounded-full text-white border border-white/30">
          <p class="text-sm md:text-base font-semibold">📍 {t('hero.location.badge')}</p>
        </div>
      </div>
    </div>
    
    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce z-10">
      <div class="w-8 h-12 border-2 border-white/60 rounded-full flex items-start justify-center p-2">
        <div class="w-1.5 h-3 bg-white/60 rounded-full animate-pulse"></div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-24 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-foreground">
          {t('features.title')}
        </h2>
        <div class="h-1 w-24 bg-accent mx-auto mb-6"></div>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          {t('features.subtitle')}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Feature 1 -->
        <div class="text-center group cursor-pointer">
          <div class="relative mb-6">
            <div class="w-28 h-28 mx-auto rounded-2xl bg-gradient-to-br from-accent to-primary flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shadow-xl">
              <Martini className="w-14 h-14 text-white" />
            </div>
            <div class="absolute -bottom-2 -right-2 w-8 h-8 bg-accent rounded-full flex items-center justify-center text-white font-bold text-sm shadow-lg">
              🍹
            </div>
          </div>
          <h3 class="text-xl font-bold mb-3 text-foreground group-hover:text-accent transition-colors">
            {t('features.cocktails.title')}
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            {t('features.cocktails.description')}
          </p>
        </div>
        
        <!-- Feature 2 -->
        <div class="text-center group cursor-pointer">
          <div class="relative mb-6">
            <div class="w-28 h-28 mx-auto rounded-2xl bg-gradient-to-br from-primary to-secondary flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shadow-xl">
              <UtensilsCrossed className="w-14 h-14 text-white" />
            </div>
            <div class="absolute -bottom-2 -right-2 w-8 h-8 bg-primary rounded-full flex items-center justify-center text-white font-bold text-sm shadow-lg">
              🍽️
            </div>
          </div>
          <h3 class="text-xl font-bold mb-3 text-foreground group-hover:text-primary transition-colors">
            {t('features.food.title')}
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            {t('features.food.description')}
          </p>
        </div>
        
        <!-- Feature 3 -->
        <div class="text-center group cursor-pointer">
          <div class="relative mb-6">
            <div class="w-28 h-28 mx-auto rounded-2xl bg-gradient-to-br from-blue-400 to-cyan-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shadow-xl">
              <Waves className="w-14 h-14 text-white" />
            </div>
            <div class="absolute -bottom-2 -right-2 w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white font-bold text-sm shadow-lg">
              🏖️
            </div>
          </div>
          <h3 class="text-xl font-bold mb-3 text-foreground group-hover:text-blue-600 transition-colors">
            {t('features.beach.title')}
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            {t('features.beach.description')}
          </p>
        </div>
        
        <!-- Feature 4 -->
        <div class="text-center group cursor-pointer">
          <div class="relative mb-6">
            <div class="w-28 h-28 mx-auto rounded-2xl bg-gradient-to-br from-purple-400 to-pink-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shadow-xl">
              <Music className="w-14 h-14 text-white" />
            </div>
            <div class="absolute -bottom-2 -right-2 w-8 h-8 bg-purple-500 rounded-full flex items-center justify-center text-white font-bold text-sm shadow-lg">
              🎵
            </div>
          </div>
          <h3 class="text-xl font-bold mb-3 text-foreground group-hover:text-purple-600 transition-colors">
            {t('features.music.title')}
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            {t('features.music.description')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="py-20 bg-card">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <div class="aspect-square rounded-lg overflow-hidden shadow-2xl">
            <img src="/acai-bowl.jpg" alt="Fresh Acai Bowl at The Ritz" class="w-full h-full object-cover" />
          </div>
        </div>
        
        <div class="order-1 lg:order-2">
          <h2 class="text-4xl md:text-5xl font-bold mb-6 text-foreground">
            {t('about.title')}
          </h2>
          <div class="h-1 w-24 bg-accent mb-6"></div>
          <p class="text-lg text-muted-foreground mb-6">
            {t('about.subtitle')}
          </p>
          <p class="text-lg text-muted-foreground mb-6">
            {t('about.text1')}
          </p>
          <p class="text-lg text-muted-foreground mb-8">
            {t('about.text2')}
          </p>
          <a href={`/${lang}/about`}>
            <Button size="lg" variant="default">
              {t('about.cta')}
            </Button>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Food Highlights -->
  <section class="py-20 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-foreground">
          {t('food.title')}
        </h2>
        <div class="h-1 w-24 bg-accent mx-auto mb-6"></div>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          {t('food.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-card rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <div class="aspect-video overflow-hidden">
            <img src="/acai-bowl.jpg" alt="Acai Bowl" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-semibold mb-2 text-foreground">{t('food.acai.title')}</h3>
            <p class="text-muted-foreground">{t('food.acai.description')}</p>
          </div>
        </div>

        <div class="bg-card rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <div class="aspect-video overflow-hidden">
            <img src="/hamburger.jpg" alt="Gourmet Burger" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-semibold mb-2 text-foreground">{t('food.burger.title')}</h3>
            <p class="text-muted-foreground">{t('food.burger.description')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Signature Drinks Preview -->
  <section class="py-24 bg-gradient-to-b from-card to-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-block mb-4 px-4 py-2 bg-accent/10 rounded-full">
          <span class="text-accent font-semibold text-sm uppercase tracking-wider">{t('drinks.badge')}</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-foreground">
          {t('drinks.title')}
        </h2>
        <div class="h-1 w-24 bg-accent mx-auto mb-6"></div>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          {t('drinks.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <!-- Drink 1 -->
        <div class="group bg-background rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="aspect-square overflow-hidden relative">
            <img src="/smoothies.jpg" alt="Smoothies" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
            <div class="absolute top-4 right-4 bg-accent text-white px-3 py-1 rounded-full text-sm font-bold shadow-lg">
              {t('drinks.badge.popular')}
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold mb-2 text-foreground group-hover:text-accent transition-colors">{t('drinks.smoothies.title')}</h3>
            <p class="text-muted-foreground mb-4 leading-relaxed">{t('drinks.smoothies.description')}</p>
            <div class="flex justify-between items-center pt-4 border-t">
              <span class="text-3xl font-bold text-accent">€5.50</span>
              <span class="text-sm text-muted-foreground">🥤 {t('drinks.smoothies.tag')}</span>
            </div>
          </div>
        </div>

        <!-- Drink 2 -->
        <div class="group bg-background rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="aspect-square overflow-hidden relative">
            <img src="/mojito.jpg" alt="Mojito" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
            <div class="absolute top-4 right-4 bg-green-500 text-white px-3 py-1 rounded-full text-sm font-bold shadow-lg">
              {t('drinks.badge.classic')}
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold mb-2 text-foreground group-hover:text-green-600 transition-colors">{t('drinks.mojito.title')}</h3>
            <p class="text-muted-foreground mb-4 leading-relaxed">{t('drinks.mojito.description')}</p>
            <div class="flex justify-between items-center pt-4 border-t">
              <span class="text-3xl font-bold text-accent">€7.50</span>
              <span class="text-sm text-muted-foreground">🍹 {t('drinks.mojito.tag')}</span>
            </div>
          </div>
        </div>

        <!-- Drink 3 -->
        <div class="group bg-background rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="aspect-square overflow-hidden relative">
            <img src="/caramel-heaven.jpg" alt="Caramel Heaven" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
            <div class="absolute top-4 right-4 bg-amber-600 text-white px-3 py-1 rounded-full text-sm font-bold shadow-lg">
              {t('drinks.badge.sweet')}
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold mb-2 text-foreground group-hover:text-amber-600 transition-colors">{t('drinks.caramel.title')}</h3>
            <p class="text-muted-foreground mb-4 leading-relaxed">{t('drinks.caramel.description')}</p>
            <div class="flex justify-between items-center pt-4 border-t">
              <span class="text-3xl font-bold text-accent">€4.95</span>
              <span class="text-sm text-muted-foreground">☕ {t('drinks.caramel.tag')}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a href={`/${lang}/menu`}>
          <button class="px-10 py-5 text-lg font-semibold bg-primary text-primary-foreground rounded-xl hover:bg-accent hover:scale-105 transition-all duration-300 shadow-xl hover:shadow-2xl">
            {t('drinks.cta')} →
          </button>
        </a>
      </div>
    </div>
  </section>

  <!-- Contact/Location Section -->
  <section class="py-24 bg-gradient-to-br from-primary via-primary to-accent text-primary-foreground relative overflow-hidden">
    <!-- Decorative Elements -->
    <div class="absolute top-0 left-0 w-64 h-64 bg-accent/20 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-primary-foreground/10 rounded-full blur-3xl translate-x-1/2 translate-y-1/2"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16">
        <div class="inline-block mb-4 px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full">
          <span class="text-white font-semibold text-sm uppercase tracking-wider">📍 {t('contact.badge')}</span>
        </div>
        <h2 class="text-4xl md:text-6xl font-bold mb-6 text-white drop-shadow-lg">
          {t('contact.title')}
        </h2>
        <div class="h-1 w-32 bg-white mx-auto mb-6"></div>
        <p class="text-xl text-white/90 max-w-2xl mx-auto">
          {t('contact.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <!-- Google Maps -->
        <div class="aspect-square rounded-lg overflow-hidden shadow-2xl">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2971.8472874396487!2d2.8450!3d41.7020!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12bae72e0d6f3f3f%3A0x0!2sCarrer%20del%20Carme%2C%2043%2C%2017310%20Lloret%20de%20Mar%2C%20Girona%2C%20Spain!5e0!3m2!1sen!2s!4v1234567890"
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="The Ritz Location"
          ></iframe>
        </div>

        <div class="space-y-6">
          <!-- Location Card -->
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 hover:bg-white/15 transition-all duration-300 border border-white/20">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-accent flex items-center justify-center flex-shrink-0">
                <MapPin className="w-6 h-6 text-white" />
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2 text-white">{t('contact.location')}</h3>
                <p class="text-lg text-white/90 leading-relaxed">
                  {t('contact.address')}
                </p>
              </div>
            </div>
          </div>

          <!-- Phone Card -->
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 hover:bg-white/15 transition-all duration-300 border border-white/20">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-accent flex items-center justify-center flex-shrink-0">
                <Phone className="w-6 h-6 text-white" />
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2 text-white">{t('contact.phone')}</h3>
                <a href="tel:+31618758383" class="text-lg text-white/90 hover:text-accent transition-colors">
                  +31 6 18758383
                </a>
              </div>
            </div>
          </div>

          <!-- Hours Card -->
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 hover:bg-white/15 transition-all duration-300 border border-white/20">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-accent flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2 text-white">{t('contact.hours')}</h3>
                <p class="text-lg text-white/90">
                  {t('contact.hours')}
                </p>
              </div>
            </div>
          </div>

          <!-- WhatsApp CTA -->
          <a href="https://wa.me/31618758383" target="_blank" rel="noopener noreferrer" class="block">
            <button class="w-full px-8 py-5 text-lg font-bold bg-white text-primary rounded-xl hover:bg-accent hover:text-white hover:scale-105 transition-all duration-300 shadow-2xl flex items-center justify-center gap-3">
              <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
