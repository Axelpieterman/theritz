---
import Layout from '../../layouts/Layout.astro';
import { Button } from '../../components/ui/button';
import { useTranslations } from '../../i18n/ui';
import { languages, type Language } from '../../i18n/languages';
import { Martini, UtensilsCrossed, Waves, Music, MapPin, Phone } from 'lucide-react';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);
---

<Layout title={`The Ritz - Lloret de Mar | ${t('hero.title')}`} lang={lang}>
  <!-- Hero Section -->
  <section class="relative h-screen flex items-center justify-center overflow-hidden -mt-24">
    <!-- Background Image with Ken Burns Effect -->
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-black/30 z-10"></div>
      <img 
        src="/bar-photo-1.jpg" 
        alt="The Ritz Atmosphere" 
        class="w-full h-full object-cover scale-110 animate-[ken-burns_20s_ease-in-out_infinite_alternate]"
      />
    </div>

    <!-- Hero Content -->
    <div class="container mx-auto px-4 md:px-6 relative z-20">
      <div class="max-w-4xl mx-auto">
        <div class="luminous-card p-8 md:p-12 lg:p-16 text-center animate-fade-in-up">
          <!-- Architectural Logo -->
          <div class="mb-10 md:mb-12 relative inline-block">
            <div class="absolute inset-0 bg-primary/30 blur-[120px] rounded-full scale-[3] animate-pulse"></div>
            <img 
              src="/ritzlogo.png" 
              alt="The Ritz Logo" 
              class="h-24 md:h-32 lg:h-36 w-auto relative z-10 brightness-0 invert drop-shadow-[0_0_30px_rgba(197,160,89,0.6)]" 
            />
          </div>

          <div class="space-y-8 md:space-y-10">
            <h1 class="text-5xl sm:text-7xl md:text-9xl lg:text-[10rem] font-black text-white uppercase tracking-tighter leading-[0.85] text-balance">
              {t('hero.title')}
            </h1>
            
            <div class="flex items-center justify-center gap-6 md:gap-8">
              <div class="h-[2px] w-16 md:w-20 bg-gradient-to-r from-transparent via-primary to-transparent"></div>
              <p class="text-primary font-bold uppercase tracking-[0.5em] md:tracking-[0.6em] text-xs md:text-base whitespace-nowrap">
                {t('hero.subtitle')}
              </p>
              <div class="h-[2px] w-16 md:w-20 bg-gradient-to-r from-transparent via-primary to-transparent"></div>
            </div>

            <p class="text-lg md:text-2xl lg:text-3xl text-white/90 max-w-3xl mx-auto leading-relaxed font-medium text-balance">
              {t('hero.description')}
            </p>

            <div class="flex flex-col sm:flex-row gap-4 md:gap-6 justify-center pt-8 md:pt-12">
              <a href={`/${lang}/menu`} class="group/btn">
                <button class="w-full sm:w-auto rounded-full px-8 md:px-12 py-4 md:py-6 text-[10px] md:text-[11px] font-bold uppercase tracking-[0.3em] border border-white/10 text-white hover:bg-white hover:text-black transition-all duration-700 shadow-2xl relative overflow-hidden">
                  <span class="relative z-10">{t('hero.cta.menu')}</span>
                  <div class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/5 to-white/0 translate-x-[-100%] group-hover/btn:translate-x-[100%] transition-transform duration-1000"></div>
                </button>
              </a>
              <a href="https://wa.me/31618758383" target="_blank" rel="noopener noreferrer" class="group/btn">
                <button class="w-full sm:w-auto rounded-full px-8 md:px-12 py-4 md:py-6 text-[10px] md:text-[11px] font-bold uppercase tracking-[0.3em] bg-primary text-white hover:bg-white hover:text-black transition-all duration-700 shadow-[0_20px_40px_rgba(197,160,89,0.2)] flex items-center justify-center gap-2 md:gap-3">
                  <div class="relative flex h-2 w-2">
                    <div class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></div>
                    <div class="relative inline-flex rounded-full h-2 w-2 bg-white"></div>
                  </div>
                  <span class="relative z-10">{t('hero.cta.reserve')}</span>
                </button>
              </a>
            </div>

            <div class="pt-8 md:pt-12">
              <div class="inline-flex items-center gap-3 md:gap-4 px-4 md:px-6 py-2 md:py-3 bg-white/[0.03] rounded-full border border-white/5 backdrop-blur-xl">
                <div class="flex h-1.5 w-1.5 rounded-full bg-primary animate-pulse"></div>
                <span class="text-[9px] md:text-[10px] font-bold text-white/50 uppercase tracking-[0.3em] md:tracking-[0.4em]">
                  {t('hero.location.badge')}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Animated Scroll Indicator -->
    <div class="absolute bottom-12 md:bottom-16 left-1/2 -translate-x-1/2 z-20 hidden md:flex flex-col items-center gap-3 opacity-60 hover:opacity-100 transition-opacity cursor-pointer">
      <span class="text-[9px] font-black text-white uppercase tracking-[0.5em] rotate-180 [writing-mode:vertical-lr]">Scroll</span>
      <div class="w-[1px] h-20 bg-gradient-to-b from-primary via-primary/50 to-transparent animate-pulse"></div>
    </div>
  </section>

  <style>
    @keyframes ken-burns {
      0% { transform: scale(1); }
      100% { transform: scale(1.1); }
    }
  </style>

  <!-- Features Section -->
  <section class="py-40 bg-background relative overflow-hidden">
    <!-- Sophisticated Lighting -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-[radial-gradient(circle_at_top,rgba(197,160,89,0.08),transparent_70%)]"></div>
    <div class="absolute bottom-0 left-1/4 w-[500px] h-[500px] bg-primary/5 rounded-full blur-[150px] animate-pulse"></div>
    
    <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
      <div class="text-center mb-32 space-y-4">
        <div class="inline-flex items-center gap-4">
          <div class="h-[1px] w-8 bg-primary/30"></div>
          <p class="text-primary font-bold uppercase tracking-[0.5em] text-[10px]">Lifestyle</p>
          <div class="h-[1px] w-8 bg-primary/30"></div>
        </div>
        <h2 class="text-6xl md:text-9xl font-black text-foreground uppercase tracking-tighter leading-none text-balance">
          {t('features.title')}
        </h2>
        <p class="text-xl md:text-2xl text-muted-foreground max-w-2xl mx-auto font-medium leading-relaxed opacity-80 pt-4">
          {t('features.subtitle')}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16">
        {[{ icon: Martini, key: 'cocktails', color: 'bg-accent/10' }, { icon: UtensilsCrossed, key: 'food', color: 'bg-primary/10' }, { icon: Waves, key: 'beach', color: 'bg-blue-400/10' }, { icon: Music, key: 'music', color: 'bg-purple-400/10' }].map((item, i) => (
          <div class="group relative space-y-8 p-4 hover:translate-y-[-10px] transition-all duration-700">
            <div class={`w-24 h-24 rounded-[2rem] flex items-center justify-center transition-all duration-700 group-hover:scale-110 group-hover:shadow-[0_20px_40px_rgba(197,160,89,0.2)] ${item.color}`}>
              <item.icon className="w-10 h-10 text-primary" />
            </div>
            <div class="space-y-4">
              <h3 class="text-3xl font-black text-foreground uppercase tracking-tight group-hover:text-primary transition-colors">
                {t(`features.${item.key}.title`)}
              </h3>
              <p class="text-lg text-muted-foreground leading-relaxed font-medium opacity-70">
                {t(`features.${item.key}.description`)}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About Section - Overhauled -->
  <section class="py-32 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
        <div class="lg:col-span-7 relative">
          <div class="absolute -top-10 -left-10 w-40 h-40 bg-primary/10 rounded-full blur-3xl animate-pulse"></div>
          <div class="absolute -bottom-10 -right-10 w-60 h-60 bg-accent/10 rounded-full blur-3xl animate-pulse delay-1000"></div>
          
          <div class="relative grid grid-cols-2 gap-4">
            <div class="space-y-4 pt-12">
              <div class="rounded-[2.5rem] overflow-hidden shadow-2xl transform hover:scale-105 transition-transform duration-700">
                <img src="/acai-bowl.jpg" alt="Acai Bowl" class="w-full h-full object-cover aspect-[3/4]" />
              </div>
              <div class="rounded-[2.5rem] overflow-hidden shadow-2xl transform hover:scale-105 transition-transform duration-700">
                <img src="/smoothies.jpg" alt="Smoothies" class="w-full h-full object-cover aspect-square" />
              </div>
            </div>
            <div class="space-y-4">
              <div class="rounded-[2.5rem] overflow-hidden shadow-2xl transform hover:scale-105 transition-transform duration-700">
                <img src="/hamburger.jpg" alt="Burger" class="w-full h-full object-cover aspect-square" />
              </div>
              <div class="rounded-[2.5rem] overflow-hidden shadow-2xl transform hover:scale-105 transition-transform duration-700">
                <img src="/bar-photo-1.jpg" alt="Atmosphere" class="w-full h-full object-cover aspect-[3/4]" />
              </div>
            </div>
          </div>
        </div>
        
        <div class="lg:col-span-5 space-y-8">
          <p class="text-primary font-bold uppercase tracking-[0.4em] text-xs">The Vibe</p>
          <h2 class="text-4xl md:text-6xl font-black text-foreground uppercase tracking-tighter leading-none text-balance">
            {t('about.title')}
          </h2>
          <div class="h-[2px] w-24 bg-primary"></div>
          <p class="text-xl text-foreground font-bold leading-snug text-balance italic">
            {t('about.subtitle')}
          </p>
          <div class="space-y-6 text-muted-foreground text-lg leading-relaxed font-medium">
            <p>{t('about.text1')}</p>
            <p>{t('about.text2')}</p>
          </div>
          
          <div class="pt-8 flex flex-col sm:flex-row gap-4">
            <a href={`/${lang}/about`}>
              <button class="w-full sm:w-auto rounded-full px-10 py-5 text-sm font-bold uppercase tracking-widest bg-primary text-white hover:bg-foreground hover:scale-105 transition-all duration-500 shadow-xl shadow-primary/20">
                {t('about.cta')}
              </button>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Food Highlights -->
  <section class="py-20 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-foreground">
          {t('food.title')}
        </h2>
        <div class="h-1 w-24 bg-accent mx-auto mb-6"></div>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          {t('food.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-card rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <div class="aspect-video overflow-hidden">
            <img src="/acai-bowl.jpg" alt="Acai Bowl" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-semibold mb-2 text-foreground">{t('food.acai.title')}</h3>
            <p class="text-muted-foreground">{t('food.acai.description')}</p>
          </div>
        </div>

        <div class="bg-card rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <div class="aspect-video overflow-hidden">
            <img src="/hamburger.jpg" alt="Gourmet Burger" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-semibold mb-2 text-foreground">{t('food.burger.title')}</h3>
            <p class="text-muted-foreground">{t('food.burger.description')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Signature Drinks Preview -->
  <section class="py-24 bg-gradient-to-b from-card to-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-block mb-4 px-4 py-2 bg-accent/10 rounded-full">
          <span class="text-accent font-semibold text-sm uppercase tracking-wider">{t('drinks.badge')}</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-foreground">
          {t('drinks.title')}
        </h2>
        <div class="h-1 w-24 bg-accent mx-auto mb-6"></div>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          {t('drinks.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <!-- Drink 1 -->
        <div class="group bg-background rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="aspect-square overflow-hidden relative">
            <img src="/smoothies.jpg" alt="Smoothies" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
            <div class="absolute top-4 right-4 bg-accent text-white px-3 py-1 rounded-full text-sm font-bold shadow-lg">
              {t('drinks.badge.popular')}
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold mb-2 text-foreground group-hover:text-accent transition-colors">{t('drinks.smoothies.title')}</h3>
            <p class="text-muted-foreground mb-4 leading-relaxed">{t('drinks.smoothies.description')}</p>
            <div class="flex justify-between items-center pt-4 border-t">
              <span class="text-3xl font-bold text-accent">€5.50</span>
              <span class="text-sm text-muted-foreground">🥤 {t('drinks.smoothies.tag')}</span>
            </div>
          </div>
        </div>

        <!-- Drink 2 -->
        <div class="group bg-background rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="aspect-square overflow-hidden relative">
            <img src="/mojito.jpg" alt="Mojito" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
            <div class="absolute top-4 right-4 bg-green-500 text-white px-3 py-1 rounded-full text-sm font-bold shadow-lg">
              {t('drinks.badge.classic')}
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold mb-2 text-foreground group-hover:text-green-600 transition-colors">{t('drinks.mojito.title')}</h3>
            <p class="text-muted-foreground mb-4 leading-relaxed">{t('drinks.mojito.description')}</p>
            <div class="flex justify-between items-center pt-4 border-t">
              <span class="text-3xl font-bold text-accent">€7.50</span>
              <span class="text-sm text-muted-foreground">🍹 {t('drinks.mojito.tag')}</span>
            </div>
          </div>
        </div>

        <!-- Drink 3 -->
        <div class="group bg-background rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="aspect-square overflow-hidden relative">
            <img src="/caramel-heaven.jpg" alt="Caramel Heaven" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
            <div class="absolute top-4 right-4 bg-amber-600 text-white px-3 py-1 rounded-full text-sm font-bold shadow-lg">
              {t('drinks.badge.sweet')}
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold mb-2 text-foreground group-hover:text-amber-600 transition-colors">{t('drinks.caramel.title')}</h3>
            <p class="text-muted-foreground mb-4 leading-relaxed">{t('drinks.caramel.description')}</p>
            <div class="flex justify-between items-center pt-4 border-t">
              <span class="text-3xl font-bold text-accent">€4.95</span>
              <span class="text-sm text-muted-foreground">☕ {t('drinks.caramel.tag')}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a href={`/${lang}/menu`}>
          <button class="px-10 py-5 text-lg font-semibold bg-primary text-primary-foreground rounded-xl hover:bg-accent hover:scale-105 transition-all duration-300 shadow-xl hover:shadow-2xl">
            {t('drinks.cta')} →
          </button>
        </a>
      </div>
    </div>
  </section>

  <!-- Reviews Section -->
  <section class="py-24 bg-background/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-block mb-4 px-4 py-2 bg-green-100 rounded-full">
          <span class="text-green-700 font-semibold text-sm uppercase tracking-wider">⭐ {t('reviews.badge')}</span>
        </div>
        <h2 class="text-4xl md:text-6xl font-bold mb-6 bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent">
          {t('reviews.title')}
        </h2>
        <div class="h-1 w-32 bg-gradient-to-r from-primary to-accent mx-auto mb-6"></div>
        <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
          {t('reviews.subtitle')}
        </p>
      </div>

      <!-- TripAdvisor Widget Container -->
      <div class="max-w-5xl mx-auto">
        <!-- TripAdvisor Widget -->
        <div id="TA_cdsratingsonlynarrow649" class="TA_cdsratingsonlynarrow">
          <ul id="sKyuBlm" class="TA_links lqTHtNFz">
            <li id="YGkm7K5" class="BaGrSOuk">
              <a target="_blank" href="https://www.tripadvisor.nl/Restaurant_Review-g494960-d8536741-Reviews-The_Ritz_Lloret-Lloret_de_Mar_Costa_Brava_Province_of_Girona_Catalonia.html">
                <img src="https://www.tripadvisor.nl/img/cdsi/img2/branding/v2/Tripadvisor_lockup_horizontal_secondary_registered-11900-2.svg" alt="TripAdvisor"/>
              </a>
            </li>
          </ul>
        </div>
        <script async src="https://www.jqueryscript.net/demo/Display-TripAdvisor-Reviews-Ratings-JavaScript-Plugin/src/tripadvisor_api_v1.js"></script>
        <script>
          if (typeof window !== 'undefined') {
            window.taValidate = window.taValidate || function(){
              (window.taValidate.q=window.taValidate.q||[]).push(arguments)
            };
            window.taValidate('init',{
              locationId: 8536741
            });
          }
        </script>
        
        <!-- Fallback Display -->
        <div class="bg-white rounded-2xl shadow-xl p-8 text-center mt-8">
          <div class="flex items-center justify-center gap-4 mb-4">
            <img src="https://static.tacdn.com/img2/brand_refresh/Tripadvisor_lockup_horizontal_secondary_registered.svg" alt="TripAdvisor" class="h-8" />
          </div>
          <h3 class="text-2xl font-bold text-foreground mb-2">The Ritz Lloret</h3>
          <div class="text-4xl mb-4">⭐⭐⭐⭐⭐</div>
          <p class="text-muted-foreground mb-4">See what travelers are saying about us!</p>
        </div>
      </div>

      <!-- Link to TripAdvisor -->
      <div class="text-center mt-12">
        <a 
          href="https://www.tripadvisor.nl/Restaurant_Review-g494960-d8536741-Reviews-The_Ritz_Lloret-Lloret_de_Mar_Costa_Brava_Province_of_Girona_Catalonia.html" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 text-lg font-semibold bg-green-600 text-white rounded-xl hover:bg-green-700 hover:scale-105 transition-all duration-300 shadow-xl hover:shadow-2xl"
        >
          {t('reviews.cta')} →
        </a>
      </div>
    </div>
  </section>

  <!-- Contact/Location Section -->
  <section class="py-32 bg-secondary/50 relative overflow-hidden">
    <!-- Subtle Background Elements -->
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-primary/5 rounded-full blur-[150px]"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-accent/5 rounded-full blur-[150px]"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-20">
        <div class="inline-flex items-center gap-4 mb-6">
          <div class="h-[1px] w-12 bg-primary/30"></div>
          <span class="text-primary font-bold uppercase tracking-[0.5em] text-[10px]">Location</span>
          <div class="h-[1px] w-12 bg-primary/30"></div>
        </div>
        <h2 class="text-5xl md:text-8xl font-black mb-8 text-foreground uppercase tracking-tighter">
          {t('contact.title')}
        </h2>
        <p class="text-xl text-muted-foreground max-w-2xl mx-auto font-medium">
          {t('contact.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <!-- Google Maps -->
        <div class="aspect-square rounded-[3rem] overflow-hidden shadow-2xl border border-primary/10">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2971.8472874396487!2d2.8450!3d41.7020!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12bae72e0d6f3f3f%3A0x0!2sCarrer%20del%20Carme%2C%2043%2C%2017310%20Lloret%20de%20Mar%2C%20Girona%2C%20Spain!5e0!3m2!1sen!2s!4v1234567890"
            width="100%" 
            height="100%" 
            style={{border: 0}} 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="The Ritz Location"
          ></iframe>
        </div>

        <div class="space-y-8">
          <!-- Location Card -->
          <div class="bg-white rounded-[2rem] p-8 hover:shadow-xl transition-all duration-500 border border-primary/10 group">
            <div class="flex items-start gap-5">
              <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center flex-shrink-0 group-hover:bg-primary group-hover:scale-110 transition-all duration-500">
                <MapPin className="w-6 h-6 text-primary group-hover:text-white transition-colors" />
              </div>
              <div>
                <h3 class="text-sm font-black mb-3 text-primary uppercase tracking-[0.3em]">{t('contact.location')}</h3>
                <p class="text-lg text-foreground font-medium leading-relaxed">
                  {t('contact.address')}
                </p>
              </div>
            </div>
          </div>

          <!-- Phone Card -->
          <div class="bg-white rounded-[2rem] p-8 hover:shadow-xl transition-all duration-500 border border-primary/10 group">
            <div class="flex items-start gap-5">
